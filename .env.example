# Copy to .env and adjust for local use. Every value here is read by core/config.py.

# --- Core infra ---
DATABASE_URL=postgresql+psycopg://pulse:pulse@postgres:5432/pulse
REDIS_URL=redis://redis:6379/0

# --- Redis stream (Phase 1/2) ---
EVENT_STREAM=pulse:events
CONSUMER_GROUP=pulse-consumers
CONSUMER_NAME=consumer-1
STREAM_BATCH_SIZE=200
STREAM_BLOCK_TIMEOUT_MS=5000

# --- Aggregation (Phase 2) ---
AGGREGATION_WINDOW_SECONDS=60

# --- Anomaly detection (Phase 4) ---
ZSCORE_THRESHOLD=3.0
EWMA_ALPHA=0.3
ISOLATION_FOREST_CONTAMINATION=0.05

# --- Alerts (Phase 5) ---
WEBHOOK_URL=
WEBHOOK_MAX_RETRIES=3

# --- Runtime ---
LOG_LEVEL=INFO

# --- Postgres container init (used by docker-compose, not by the app directly) ---
POSTGRES_USER=pulse
POSTGRES_PASSWORD=pulse
POSTGRES_DB=pulse
